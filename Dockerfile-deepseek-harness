# 使用 Debian 最新版作为基础镜像
FROM debian:latest

# 设置环境变量，避免交互式安装提示
ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /app

# ===== 第1步：安装系统基础工具和 Python 环境 =====
RUN apt-get update && \
    apt-get install -y \
    bash \
    vim \
    curl \
    wget \
    git \
    openssh-server \
    python3 \
    python3-pip \
    python3-venv \
    build-essential \
    socat \
    && rm -rf /var/lib/apt/lists/*

# ===== 第2步：安装 Node.js 20.x =====
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get install -y nodejs && \
    rm -rf /var/lib/apt/lists/*

# ===== 第3步：安装 pnpm（必须在克隆项目之前） =====
RUN npm install -g pnpm

# ===== 第4步：克隆并构建项目（此时 pnpm 已可用） =====
RUN git clone https://github.com/deepseek-ai/deepseek-harness.git /app && \
    pnpm install && \
    pnpm run build

# ===== 第5步：暴露端口 =====
EXPOSE 3081

# ===== 第6步：启动命令 =====
CMD ["sh", "-c", "pnpm dsh web  & sleep 2 && socat TCP-LISTEN:3081,fork,reuseaddr TCP:127.0.0.1:3080"]

